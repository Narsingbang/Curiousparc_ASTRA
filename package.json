{
  "name": "medisync-ai",
  "version": "1.0.0",
  "private": true,
  "description": "MediSync AI - Live hospital availability + AI triage, in one app",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=shared && npm run build --workspace=client && npm run build:server",
    "build:server": "esbuild server/src/vercel.ts --bundle --platform=node --target=node20 --format=cjs --outfile=api/index.js",
    "typecheck": "npm run typecheck --workspace=shared && npm run typecheck --workspace=server && npm run typecheck --workspace=client",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "verify": "tsx scripts/e2e-smoke.ts",
    "seed:demo": "tsx scripts/seed-demo-users.ts",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "eslint": "^10.12.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.0.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
